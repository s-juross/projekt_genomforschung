   "source": [
    "Pick genes with the biggest variance: $$ \\sigma^2 = \\frac{1}{N} \\sum_{i=1}^{N} (x_i - \\mu)^2 $$"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "55bc9fcf",
   "metadata": {},
   "outputs": [
    {
     "data": {
