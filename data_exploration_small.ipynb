   "source": [
    "Generate a personalized color palette"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 166,
   "id": "5e92b4e0",
   "metadata": {},
   "outputs": [],
   "source": [
    "# get unique categories for color mapping\n",
    "unique_categories = sorted(ge_matched['META_CANCERTYPE'].unique())\n",
    "\n",
    "# generate a color palette with as many colors as unique categories\n",
    "base_colors = sns.color_palette(\"Set1\", len(unique_categories))\n",
    "color_dict = dict(zip(unique_categories, base_colors))\n",
    "\n",
    "# color coding for \"Other\" and \"Control\"\n",
    "if 'Other' in color_dict:\n",
    "    color_dict['Other'] = '#d3d3d3'\n",
    "\n",
    "if 'Control' in color_dict:\n",
    "    color_dict['Control'] = '#7f7f7f'"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "e113d5e3",
   "metadata": {},
   "source": [
    "\n",
    "## t-SNE"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 164,
   "id": "ff3bb596",
   "metadata": {},
   "outputs": [],
   "source": [
    "# selection of features for t-SNE (only gene columns)\n",
    "#gene_features = master_df.drop_duplicates(subset=['ModelID']).filter(regex='\\(.*\\)')\n",
    "gene_features = ge_matched.iloc[: , 2:980]\n",
    "\n",
    "# treat missing values (t-SNE does not allow NaNs)\n",
    "gene_features = gene_features.fillna(gene_features.mean())\n",
    "\n",
    "# standardize the data (mean=0, variance=1)\n",
    "scaler = StandardScaler()\n",
    "scaled_data = scaler.fit_transform(gene_features)\n",
